#!/usr/bin/env bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
mise_bin="$HOME/.local/bin/mise"
global_skills_dir="$HOME/.config/agents/skills"

cd -- "$root"
export GIT_TERMINAL_PROMPT=0
export MISE_CEILING_PATHS="$(dirname -- "$root")"
export MISE_EXEC_AUTO_INSTALL=0
export MISE_OFFLINE=1
export PATH="$HOME/.local/bin:$PATH"

[[ -x "$mise_bin" ]] || { echo "mise is missing; run .agents/setup." >&2; exit 1; }
[[ -x "$root/target/debug/wflow" ]] || { echo "wflow is missing; run .agents/setup." >&2; exit 1; }

"$mise_bin" exec -- rustc --version
"$root/target/debug/wflow" --version

for skill in commit-work manage-pr use-workflow effect-v4; do
  [[ -f "$global_skills_dir/$skill/SKILL.md" ]] || {
    echo "Installed skill $skill is missing; run .agents/setup." >&2
    exit 1
  }
done

echo "Orb environment is ready."
